# ============================================================================
# creditsim - Environment Variables Contract
# ============================================================================
# Este archivo define todas las variables necesarias para el deployment.
# Los valores reales se gestionan con Doppler en producción.

# ------------------------
# General
# ------------------------
ENV=production
LOG_LEVEL=INFO
SERVICE_DOMAIN=creditsim.iayala.dev

# ------------------------
# Database (PostgreSQL 16)
# ------------------------
POSTGRES_USER=creditsim
POSTGRES_PASSWORD=<generated-securely>
POSTGRES_DB=creditsim
POSTGRES_PORT=5432
# Nota: Usar postgresql+psycopg:// para psycopg3
DATABASE_URL=postgresql+psycopg://creditsim:<password>@db:5432/creditsim

# ------------------------
# Redis
# ------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------
# API
# ------------------------
API_PORT=8000
# Configuración adicional de API si es necesaria

# ------------------------
# Frontend
# ------------------------
VITE_API_URL=/api

# ------------------------
# SSL/TLS (Let's Encrypt)
# ------------------------
LETSENCRYPT_EMAIL=contact@iayala.dev

# ------------------------
# Deployment
# ------------------------
# Variables para CI/CD
SSH_USER=ubuntu
SSH_HOST=18.221.67.173
SSH_PORT=22
DEPLOY_PATH=/home/ubuntu/creditsim

# Docker Registry (GitHub Container Registry)
REGISTRY=ghcr.io
IMAGE_OWNER=<your-github-username>
